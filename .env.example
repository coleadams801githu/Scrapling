# Resell Radar — environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ----- Database ---------------------------------------------------------------
# SQLite (default, works on Replit with no extra infra)
DATABASE_URL=sqlite:///resell_radar.db

# PostgreSQL example (swap in for production)
# DATABASE_URL=******localhost:5432/resell_radar

# ----- eBay -------------------------------------------------------------------
# Get a free app token from https://developer.ebay.com/
EBAY_APP_TOKEN=

# ----- SMTP (email notifications) --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# ----- Ntfy push notifications -----------------------------------------------
# Default server is ntfy.sh (free, open-source)
NTFY_URL=https://ntfy.sh
# Each user's push_token should be set to their ntfy topic name.

# ----- API server -------------------------------------------------------------
PORT=8000
# Comma-separated list of allowed CORS origins (no wildcards in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
